---
import { Image } from 'astro:assets';
import '@fontsource-variable/inter';
import '../styles/global.css';
import yodips from '../assets/yodips/yodips_web_dashboard_redacted.jpg';
import mobile from '../assets/yodips/yodips_mobile_redacted.jpg';
import extension from '../assets/yodips/yodips_extension_redacted.jpg';
import levelup from '../assets/levelup/levelup_accessibility_panel.png';
import quiz from '../assets/levelup/levelup_adaptive_quiz.png';
import landing from '../assets/levelup/levelup_landing.png';
import certificate from '../assets/levelup/citech_finalist_certificate_crop.jpg';
import listing from '../assets/lastbite/lastbite_product_listing.jpeg';
import detail from '../assets/lastbite/lastbite_product_detail.jpeg';
import seller from '../assets/lastbite/lastbite_seller_dashboard.jpeg';
import dac from '../assets/dac/dac_kaggle_notebook.png';
const siteUrl = 'https://kemal.crunchy.my.id/';
const pageTitle = 'Muhamad Kemal Faza — Software Engineer & Informatics Student';
const pageDescription =
  'Portfolio of Muhamad Kemal Faza, Software Engineer and Informatics student at Diponegoro University. Web, mobile, accessibility, and machine learning projects.';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Muhamad Kemal Faza',
      url: siteUrl,
      jobTitle: 'Software Engineer',
      description: 'Software Engineer and Informatics student at Diponegoro University.',
      affiliation: { '@type': 'CollegeOrUniversity', name: 'Diponegoro University' },
      sameAs: ['https://github.com/kemal-faza', 'https://linkedin.com/in/muhamad-kemal-faza'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Muhamad Kemal Faza — Portfolio',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#person` },
      inLanguage: 'en',
    },
  ],
};
const steps = [
  ['01', 'Understand', 'Frame the real user or system problem.'],
  ['02', 'Build', 'Turn an idea into something concrete.'],
  ['03', 'Test', 'Look for evidence, not assumptions.'],
  ['04', 'Learn', 'Take what worked into the next version.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111820" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Muhamad Kemal Faza" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content="Muhamad Kemal Faza" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhamad Kemal Faza — Software Engineer and Informatics Student" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}og-image.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // Runs before first paint. Motion's vanilla API does not honour
      // prefers-reduced-motion on its own, so the gate is decided here and the
      // animation module re-checks it. The failsafe hands content back if the
      // module never boots, so copy can never be stranded at opacity 0.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const root = document.documentElement;
        root.setAttribute('data-motion', '');
        addEventListener('load', () => {
          setTimeout(() => {
            if (!root.hasAttribute('data-motion-ready')) root.removeAttribute('data-motion');
          }, 1200);
        });
      })();
    </script>
    <meta name="google-site-verification" content="iusDaHDLOperOnnnPhLkE119tl6BwDNiQSo3MgH5uGY" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <nav class="shell flex items-center justify-between gap-4" aria-label="Main navigation">
        <a class="wordmark" href="#home" aria-label="Kemal Faza, home">kemal<span>.</span></a>
        <div class="flex items-center gap-6 sm:gap-9 text-sm">
          <a href="#work">Work</a><a href="#about">About</a><a class="nav-contact" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section id="home" class="hero">
        <div class="shell">
          <div class="hero-top"><span class="eyebrow" data-hero><span class="status-dot"></span> MUHAMAD KEMAL FAZA</span><span class="edition" data-hero>SELECTED WORK / 2026</span></div>
          <h1 data-hero>Muhamad Kemal Faza.<br />Building systems.<br /><span>Understanding people.</span></h1>
          <div class="hero-bottom">
            <p data-hero>I’m Kemal, a Software Engineer and Informatics student at Diponegoro University. I build digital products and keep asking how the systems behind them work, and who ends up using them.</p>
            <a class="primary-link" href="#work" data-hero>Explore my work <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-footer"><span data-hero>PRODUCT ENGINEERING <i>/</i> ACCESSIBILITY <i>/</i> MACHINE LEARNING</span><span class="edition" data-hero>SCROLL TO EXPLORE ↓</span></div>
        </div>
      </section>
      <section id="work" class="shell work-section" aria-labelledby="work-heading">
        <div class="section-heading" data-reveal><div><p class="eyebrow blue">A FEW THINGS I’VE BUILT</p><h2 id="work-heading">Selected work<span class="count">(04)</span></h2></div><p>Different problems.<br />The same curiosity.</p></div>
        <article class="project" id="yodips">
          <div class="project-intro" data-reveal><div><p class="eyebrow blue">01 / PRODUCT ENGINEERING</p><h3>YoDips<span class="project-dot">.</span></h3></div><p class="project-statement">Three academic systems.<br />One student experience.</p></div>
          <div class="image-stage yodips-stage" data-reveal="image"><Image src={yodips} alt="Redacted YoDips web dashboard bringing university services into one interface" widths={[640, 960, 1440]} sizes="(max-width: 700px) 90vw, 1080px" format="webp" /></div>
          <div class="project-body" data-reveal-stagger><dl class="metadata"><div><dt>YEAR / CONTEXT</dt><dd>2026 · Self-initiated · Individual</dd></div><div><dt>MY ROLE</dt><dd>Sole Developer & Product Owner</dd></div><div class="project-links"><a href="https://github.com/kemal-faza/yodips">View source ↗</a><a href="https://sso.crunchy.my.id">Visit website ↗</a></div></dl><div><h4>Less fragmentation. More focus.</h4><p>Assignments, grades, schedules, and attendance all sit in separate UNDIP systems. I built YoDips to bring SSO, Kulon, and SIAP into one place, across web, Android, and a browser extension. A few close friends use it too.</p><details><summary>Behind the build <span aria-hidden="true">+</span></summary><div class="expanded-content"><h4>Convenience should not cost you your password.</h4><p>Users sign in with the university directly. YoDips reuses the verified session instead of collecting or storing their password.</p><div class="supplemental yodips-support"><Image src={mobile} alt="Redacted YoDips Android dashboard" width={300} format="webp" /><Image src={extension} alt="YoDips browser extension setup with the backend URL redacted" width={580} format="webp" /></div><p class="lesson">What I learned: architecture and UX are connected. A secure system that feels confusing still creates friction.</p></div></details></div></div>
        </article>
        <article class="project" id="levelup">
          <div class="project-intro" data-reveal><div><p class="eyebrow blue">02 / ACCESSIBILITY</p><h3>LevelUp<span class="project-dot">.</span></h3></div><p class="project-statement">Different minds.<br />Different ways to learn.</p></div>
          <div class="image-stage levelup-stage" data-reveal="image"><Image src={levelup} alt="LevelUp learning interface showing its accessibility panel and ADHD profile" widths={[640, 960, 1440]} sizes="(max-width: 700px) 90vw, 1080px" format="webp" /></div>
          <div class="project-body" data-reveal-stagger><dl class="metadata"><div><dt>YEAR / CONTEXT</dt><dd>2026 · Competition · Team of 3</dd></div><div><dt>MY ROLE</dt><dd>Project Manager, UI Baseline Designer<br />& Contributing Developer</dd></div><div><dt>RECOGNITION</dt><dd class="blue">↗ CITECH 2026 Finalist · Universitas Jember</dd></div></dl><div><h4>Learning that adapts to the learner.</h4><p>LevelUp changes its interface to fit how someone reads and focuses, with profiles for ADHD, Dyslexia, and general learning. I coordinated the team, set the UI baseline, and built a few of the features myself.</p><details><summary>Explore the approach <span aria-hidden="true">+</span></summary><div class="expanded-content"><p>Reading controls include Lexend and OpenDyslexic, adjustable font size and spacing, text-to-speech, and focus tools. Quizzes also adjust their difficulty as you go.</p><div class="supplemental"><Image src={landing} alt="LevelUp home page" width={700} format="webp" /><Image src={quiz} alt="Adaptive quiz using the Dyslexia reading profile" width={700} format="webp" /></div><figure class="certificate"><Image src={certificate} alt="CITECH 2026 finalist certificate" width={420} format="webp" /><figcaption>Finalist evidence · CITECH 2026</figcaption></figure><p class="lesson">What I learned: accessibility is a design decision from the start, not a settings page you add at the end.</p></div></details></div></div>
        </article>
        <article class="project" id="lastbite">
          <div class="project-intro" data-reveal><div><p class="eyebrow blue">03 / HUMAN–COMPUTER INTERACTION</p><h3>LastBite<span class="project-dot">.</span></h3></div><p class="project-statement">Good food.<br />A second chance.</p></div>
          <div class="image-stage phone-gallery" data-reveal="image">{[[listing, 'LastBite listings for discounted surplus food'], [detail, 'LastBite product details and ordering'], [seller, 'LastBite seller dashboard']].map(([src, alt]) => <Image src={src as ImageMetadata} alt={alt as string} widths={[240, 400]} sizes="(max-width: 700px) 25vw, 260px" format="webp" data-parallax />)}</div>
          <div class="project-body" data-reveal-stagger><dl class="metadata"><div><dt>YEAR / CONTEXT</dt><dd>2026 · Class + Competition · Team of 3</dd></div><div><dt>MY ROLE</dt><dd>Programmer during the team prototype;<br />built it out on my own afterward</dd></div><div><dt>VALIDATION</dt><dd>11 users · System Usability Scale</dd></div></dl><div><h4>From class prototype to something I kept building.</h4><p>LastBite connects businesses that have safe, unsold food with people looking for a cheap meal. Buyers browse discounted listings and pick up at a scheduled time. After the group prototype, I kept going and built it out further on Android.</p><details><summary>What testing taught me <span aria-hidden="true">+</span></summary><div class="expanded-content"><p>We tested the prototype with 11 users using the System Usability Scale (SUS).</p><p class="lesson">A flow that makes sense to me does not always make sense to the user. Building past the assignment showed me how much a prototype leaves open.</p></div></details></div></div>
        </article>
        <article class="project" id="dac">
          <div class="project-intro" data-reveal><div><p class="eyebrow blue">04 / MACHINE LEARNING</p><h3>Beyond the pixels<span class="project-dot">.</span></h3></div><p class="project-statement">Deepfake classification.<br />Evidence over intuition.</p></div>
          <div class="image-stage dac-stage" data-reveal="image"><Image src={dac} alt="DAC Find-IT Kaggle notebook and submitted private score of 0.73969" widths={[640, 960, 1440]} sizes="(max-width: 700px) 90vw, 1080px" format="webp" /></div>
          <div class="project-body" data-reveal-stagger><dl class="metadata"><div><dt>PROJECT</dt><dd>DAC Find-IT 2026</dd></div><div><dt>YEAR / CONTEXT</dt><dd>2026 · Competition · Team of 3</dd></div><div><dt>MY ROLE</dt><dd>Collaborative ML Experimentation</dd></div></dl><div><h4>Getting a good score is an experimentation problem.</h4><p>Each of us trained and compared approaches. Our submitted notebook used ConvNeXt Tiny for six-class classification, stratified five-fold validation, and a five-model ensemble.</p><div class="metrics"><div><strong data-count>0.8177</strong><span>Best fold validation Macro F1</span></div><div><strong data-count>0.73969</strong><span>Kaggle private score</span></div></div><details><summary>Inside the experiment <span aria-hidden="true">+</span></summary><div class="expanded-content"><p>We used class-balanced weights, cross-entropy with 0.1 label smoothing, and CosineAnnealingLR. We saved the best model per fold and ran three-way test-time augmentation, giving 15 probability outputs per image.</p><p class="lesson">What I learned: validation, class imbalance, augmentation, and inference decisions affect reliability as much as architecture does.</p></div></details></div></div>
        </article>
      </section>
      <section id="about" class="about-section"><div class="shell"><p class="eyebrow blue" data-reveal>THE PERSON BEHIND THE PROJECTS</p><div class="about-grid" data-reveal-stagger><h2>From “does it work?”<br />to <span>“who is it for?”</span></h2><div><p>My projects slowly moved from pure implementation toward product thinking, accessibility, user testing, and experimentation. The tools changed. The habit of learning did not.</p><p>I’m studying Informatics at Diponegoro University. I treat systems, accessibility, and machine learning as different tools for the same job: understanding a problem and solving it.</p></div></div><div class="process-grid" data-reveal-stagger>{steps.map(([number, title, description]) => <div><span class="step-number">{number}</span><h3>{title}<span aria-hidden="true">↗</span></h3><p>{description}</p></div>)}</div><div class="academy-note" data-reveal><p class="eyebrow">THE NEXT CHAPTER / APPLE DEVELOPER ACADEMY</p><p>I know how to build. Now I want to get better at deciding what is worth building, by learning from users and working with people who think differently from me.</p></div></div></section>
      <section id="contact" class="contact-section"><div class="shell"><p class="eyebrow" data-reveal>LET’S CONNECT</p><h2 data-reveal>Good things start<br />with a <span>conversation.</span></h2><a class="email-link" href="mailto:kemalfaza26@gmail.com" data-reveal>kemalfaza26@gmail.com <span aria-hidden="true">↗</span></a><footer><a class="wordmark" href="#home">kemal<span>.</span></a><p>© {new Date().getFullYear()} Muhamad Kemal Faza</p><div class="flex gap-6"><a href="https://github.com/kemal-faza">GitHub ↗</a><a href="https://linkedin.com/in/muhamad-kemal-faza">LinkedIn ↗</a></div></footer></div></section>
    </main>
    <script>
      import { initMotion } from '../scripts/motion.js';
      initMotion();
    </script>
  </body>
</html>
